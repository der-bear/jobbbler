{
  "name": "@jobbbler/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jobbbler/connectors": "workspace:*",
    "@jobbbler/contracts": "workspace:*",
    "@jobbbler/core-domain": "workspace:*",
    "@jobbbler/jobs-domain": "workspace:*",
    "@jobbbler/storage": "workspace:*",
    "@jobbbler/storage-postgres": "workspace:*",
    "@jobbbler/storage-sqlite": "workspace:*",
    "better-sqlite3": "13.0.3",
    "pino": "10.3.1",
    "resend": "6.24.0",
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}
