# Runtime
NODE_ENV=development
DATABASE_DRIVER=sqlite
SQLITE_DATABASE_PATH=.data/jobbbler.sqlite
PUBLIC_BASE_URL=http://localhost:3000
JOBBBLER_WORKER_MODE=idle
JOBBBLER_SOURCE_LIMIT=50
JOBBBLER_WORKER_INTERVAL_SECONDS=300

# Supabase production database and auth
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email delivery. Local development defaults to the capture adapter.
NOTIFICATION_DRIVER=capture
RESEND_API_KEY=
EMAIL_FROM=Jobbbler <alerts@example.com>

# Security
TOKEN_HASH_SECRET=
SESSION_SECRET=

# Optional observability
LOG_LEVEL=info
SENTRY_DSN=
