# Runtime
NODE_ENV=development
SQLITE_DATABASE_PATH=.data/jobbbler.sqlite
PUBLIC_BASE_URL=http://localhost:3000
JOBBBLER_WORKER_MODE=idle
JOBBBLER_SOURCE_LIMIT=50
JOBBBLER_WORKER_INTERVAL_SECONDS=300
WORKER_HEARTBEAT_MAX_AGE_SECONDS=900

# Optional server-only PostgreSQL/Supabase connection. When set, web and worker use PostgreSQL; otherwise SQLite remains the local default.
DATABASE_URL=
# Public Realtime wake-up settings are embedded into the production web bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Wake-up broadcasts are optional and require a Supabase Auth JWT carrying a
# signed app_metadata.jobbbler_owner_id claim. Polling remains authoritative.
NEXT_PUBLIC_SUPABASE_ACTIVITY_WAKEUPS=false

# Optional Chrome WebMCP origin-trial token for the exact deployed HTTPS origin.
# This is a public response-header value, not a credential. It is consumed at
# web build time and must never be prefixed with NEXT_PUBLIC_ or committed.
WEBMCP_ORIGIN_TRIAL_TOKEN=

# Email delivery. Local development defaults to the capture adapter.
NOTIFICATION_DRIVER=capture
ALLOW_LOCAL_OTP_CAPTURE=true
RESEND_API_KEY=
EMAIL_FROM=Jobbbler <alerts@example.com>

# Security
TOKEN_HASH_SECRET=
PII_ENCRYPTION_KEY=
# Shared bearer secret for the hosted alert-cycle scheduler (32+ characters).
CRON_SECRET=
# Enable only when the app is behind a trusted proxy that replaces client-IP headers.
TRUST_PROXY_HEADERS=false
# Authoritative private activity polling interval (1-30 seconds).
ACTIVITY_POLL_INTERVAL_MS=5000
