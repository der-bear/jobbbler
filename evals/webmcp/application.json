          "dataPermissionStatus": "approved",
          "finalConfirmationReady": false,
          "applyMode": "internal"
        }
      },
      "prompt": "Where does this application stand now?",
      "expected": {
        "kind": "tool_call",
        "tool": "get_application_state",
        "arguments": {}
      }
    },
